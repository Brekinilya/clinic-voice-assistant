# Копировать в deploy/voice/voice.env (права 600). Пароль ARI генерирует setup_asterisk.sh
# при первом запуске, если файла ещё нет; в Git этот файл не попадает.
ARI_USER=clinic
ARI_PASSWORD=
# Панель диагностики звонков: включать вместе с backend, вход команды обязателен
DEBUG_PANEL_ENABLED=true
WEB_ACCESS_ENABLED=true
# Исходящие напоминания T11 исполняет только голосовой процесс; включать после миграции
# и заведения контакта (python -m app.reminders.cli contact-set --client-id <id>)
REMINDERS_ENABLED=false
