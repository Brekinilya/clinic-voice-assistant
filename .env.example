# Режим: offline_test | hackathon. clinic_pilot пока запрещён настройками.
APP_MODE=offline_test

# Стенд «Регистратура»: токен нужен только в режиме hackathon.
MIS_BASE_URL=https://crm-med-mock.dbi-testing.ru/api/v1
MIS_TOKEN=
MIS_RATE_LIMIT_PER_MIN=8
CLINIC_UTC_OFFSET=+04:00

# Настройки LLM подготовлены для последующей интеграции Ильи.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# PostgreSQL: значения для локальной разработки с вымышленными данными.
# Compose сам меняет адрес и порт на внутренние адреса контейнера базы.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev
DATABASE_PROBE_TIMEOUT_SECONDS=2

# Командный HTTP-стенд нашей части; доступен только с APP_MODE=offline_test.
BACKEND_DEMO_ENABLED=false
DIALOGUE_STORAGE=memory
# Для DIALOGUE_STORAGE=postgres задайте свой постоянный ключ не короче 32 байт.
DIALOGUE_HASH_KEY=
# Пока файл не предоставлен, стенд использует явно вымышленный график.
# Если задаёте путь, нужен проверенный документ JSON нашей схемы.
# SCHEDULE_PATH=C:/path/to/schedule.json
