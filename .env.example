# Режим: offline_test | hackathon. clinic_pilot пока запрещён настройками.
APP_MODE=offline_test

# Стенд «Регистратура»: токен нужен только в режиме hackathon.
MIS_BASE_URL=https://crm-med-mock.dbi-testing.ru/api/v1
MIS_TOKEN=
MIS_RATE_LIMIT_PER_MIN=8
# Сколько ход разговора ждёт окна МИС и сколько звонок ждёт без движения до регистратора.
MIS_TURN_WAIT_S=8
MIS_WAIT_LIMIT_S=120
CLINIC_UTC_OFFSET=+04:00

# Настройки LLM подготовлены для последующей интеграции Ильи.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# PostgreSQL: значения для локальной разработки с вымышленными данными.
# Compose сам меняет адрес и порт на внутренние адреса контейнера базы.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev
DATABASE_PROBE_TIMEOUT_SECONDS=2

# Вход в публичное демо по HTTPS; пароль от 24 байт, не токен МИС.
WEB_ACCESS_ENABLED=false
WEB_ACCESS_USER=clinic
WEB_ACCESS_PASSWORD=

# Текстовый HTTP-стенд; доступен только с APP_MODE=offline_test.
BACKEND_DEMO_ENABLED=false
# Внешний диалог: APP_MODE=hackathon, natural, postgres, ключ и индекс с ID МИС.
# Учебная страница /demo при этом не включается.
DIALOGUE_ENABLED=false
# commands: учебные команды без записей; natural: RulesNlu/safety и запись в автономную МИС.
DIALOGUE_MODE=commands
DIALOGUE_STORAGE=memory
# Для DIALOGUE_STORAGE=postgres задайте свой постоянный ключ не короче 32 байт.
DIALOGUE_HASH_KEY=
# Пока файл не предоставлен, стенд использует явно вымышленный график.
# Если задаёте путь, нужен проверенный документ JSON нашей схемы.
# SCHEDULE_PATH=C:/path/to/schedule.json
# Вместо JSON можно подключить индекс, созданный app.scheduling.cli import-xlsx.
# SCHEDULE_INDEX_PATH=C:/path/to/schedule.sqlite
# Подтверждённые факты допуска (участок, направление); отсутствие не означает разрешение.
# SCHEDULE_ACCESS_PATH=C:/path/to/access.json

# Голос: ограниченное ожидание движков и очереди, общие для всех звонков процесса.
VOICE_ASR_TIMEOUT_S=5
VOICE_TTS_TIMEOUT_S=5
VOICE_DIALOGUE_TIMEOUT_S=15
VOICE_INFERENCE_QUEUE_CAPACITY=2
VOICE_DIALOGUE_JOB_CAPACITY=4
VOICE_MAX_AUDIO_CHUNK_BYTES=524288
